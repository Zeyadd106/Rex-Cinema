PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
TICKET_PRICE=12
HOLD_TTL_MINUTES=10
CLIENT_URL=http://localhost:5173

# --- Supabase PostgreSQL (required) ---
# Paste the Session-mode pooler URL from Supabase Dashboard → Project Settings → Database
# (port 5432). Do NOT use the Transaction-mode pooler (port 6543): it is
# incompatible with the `pg` driver's prepared statements.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Set to "disable" only for a local Postgres without TLS. Supabase requires TLS (default on).
# DB_SSL=
# Max pool clients (use 1-2 on serverless). Default 10.
# DB_POOL_MAX=
